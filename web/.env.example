NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Server-only values must never use the NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=
# Optional after publishing; defaults to the secure callback on the current site.
# MANUAL_ACCESS_REDIRECT_URL=https://your-domain.com/auth/callback

# Hotmart webhook (server-only). Keep observe mode until the sandbox payload is certified.
# HOTMART_HOTTOK=
# HOTMART_PRODUCT_ID=
# HOTMART_MONTHLY_PLAN_ID=
# HOTMART_ANNUAL_PLAN_ID=
HOTMART_WEBHOOK_MODE=observe
# HOTMART_ACCESS_REDIRECT_URL=https://your-domain.com/auth/callback
